{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowly",
  "version": "0.1.0",
  "identifier": "app.flowly.desktop",
  "build": {
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flowly",
        "width": 720,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/libvosk.dll": "libvosk.dll",
      "vendor/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "vendor/libstdc++-6.dll": "libstdc++-6.dll",
      "vendor/libwinpthread-1.dll": "libwinpthread-1.dll",
      "vendor/model": "model"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}